              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPlan\": 2,\n  \"newCycle\": 0\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/billing/change-plan",
              "host": ["{{base_url}}"],
              "path": ["api", "billing", "change-plan"]
            }
          },
          "response": []
        },
        {
          "name": "Downgrade Plan (Pro to Basic)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPlan\": 1,\n  \"newCycle\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/billing/change-plan",
              "host": ["{{base_url}}"],
              "path": ["api", "billing", "change-plan"]
            }
          },
          "response": []
