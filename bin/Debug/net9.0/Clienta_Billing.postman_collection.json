              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planType\": 1,\n  \"billingCycle\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/billing/upgrade",
              "host": ["{{base_url}}"],
              "path": ["api", "billing", "upgrade"]
            }
          },
          "response": []
        },
        {
          "name": "Upgrade to Pro Monthly",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planType\": 2,\n  \"billingCycle\": 0\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/billing/upgrade",
              "host": ["{{base_url}}"],
              "path": ["api", "billing", "upgrade"]
            }
          },
          "response": []
