using Clienta.Api.Data;
using Clienta.Api.DTOs;
using Clienta.Api.Entities;
using Microsoft.EntityFrameworkCore;
using Npgsql;

namespace Clienta.Api.Services;

public interface IClientFileService
{
    string? ValidateUpload(IFormFile? file);
    bool TryNormalizeTitle(string? raw, out string? title);

    Task<ClientFile> CreateAsync(
        Guid tenantId,
        Guid clientId,
        Guid? projectId,
        Guid userId,
        IFormFile file,
        string? title);

    Task<ClientFile> CreateExternalPdfAsync(
        Guid tenantId,
        Guid clientId,
        Guid? projectId,
        Guid userId,
        Guid externalAccountingDocumentId,
        Stream pdfStream,
        long fileSize,
        string fileName,
        string title,
        CancellationToken cancellationToken = default);

    Task<List<FileResponse>> ListAsync(
        IQueryable<ClientFile> query,
        Guid tenantId);

    Task<Stream?> OpenReadAsync(
        ClientFile file,
        CancellationToken cancellationToken = default);

    Task DeleteAsync(ClientFile file);

    string GetContentType(string fileName);
}

// Shared ClientFile metadata/storage logic.
// Existing uploads remain on local disk.
// Durable external accounting PDFs are stored in S3.
public class ClientFileService : IClientFileService
{
    public const long MaxFileSize = 10 * 1024 * 1024;
    public const int MaxTitleLength = 200;

    private const string S3StorageProvider = "S3";

    private static readonly string[] AllowedExtensions =
    {
        ".pdf",
        ".doc",
        ".docx",
        ".xls",
        ".xlsx",
        ".txt",
        ".jpg",
        ".jpeg",
        ".png"
    };

    private readonly AppDbContext _db;
    private readonly IWebHostEnvironment _env;
    private readonly IFileStorage _fileStorage;

    public ClientFileService(
        AppDbContext db,
        IWebHostEnvironment env,
        IFileStorage fileStorage)
    {
        _db = db;
        _env = env;
        _fileStorage = fileStorage;
    }

    public string? ValidateUpload(IFormFile? file)
    {
        if (file == null || file.Length == 0)
            return "No file provided.";

        if (file.Length > MaxFileSize)
            return $"File size exceeds {MaxFileSize / (1024 * 1024)} MB limit.";

        if (!AllowedExtensions.Contains(
                Path.GetExtension(file.FileName).ToLowerInvariant()))
            return "File type not allowed.";

        return null;
    }

    public bool TryNormalizeTitle(string? raw, out string? title)
    {
        title = string.IsNullOrWhiteSpace(raw)
            ? null
            : raw.Trim();

        return title == null || title.Length <= MaxTitleLength;
    }

    // Existing behavior intentionally preserved:
    // ordinary client/project uploads remain on local disk.
    public async Task<ClientFile> CreateAsync(
        Guid tenantId,
        Guid clientId,
        Guid? projectId,
        Guid userId,
        IFormFile file,
        string? title)
    {
        var extension = Path.GetExtension(file.FileName).ToLowerInvariant();

        var uploadDir = Path.Combine(
            _env.ContentRootPath,
            "uploads",
            tenantId.ToString(),
            clientId.ToString());

        Directory.CreateDirectory(uploadDir);

        var storedFileName = $"{Guid.NewGuid()}{extension}";
        var filePath = Path.Combine(uploadDir, storedFileName);

        await using (var stream = new FileStream(filePath, FileMode.Create))
        {
            await file.CopyToAsync(stream);
        }

        var clientFile = new ClientFile
        {
            Id = Guid.NewGuid(),
            TenantId = tenantId,
            ClientId = clientId,
            ProjectId = projectId,
            Title = title,
            FileName = file.FileName,
            StoredFileName = storedFileName,
            FilePath = filePath,

            // NULL explicitly means legacy/local storage.
            StorageProvider = null,
            StorageKey = null,

            FileSize = file.Length,
            UploadedByUserId = userId,
            UploadedAt = DateTime.UtcNow
        };

        try
        {
            _db.ClientFiles.Add(clientFile);
            await _db.SaveChangesAsync(cancellationToken);
            return clientFile;
        }
        catch (DbUpdateException ex) when (
            ex.InnerException is PostgresException
            {
                SqlState: PostgresErrorCodes.UniqueViolation,
                ConstraintName: "IX_ClientFiles_Tenant_ExternalAccountingDocument"
            })
        {
            _db.Entry(clientFile).State = EntityState.Detached;

            try
            {
                await _fileStorage.DeleteAsync(storageKey);
            }
            catch
            {
                // Preserve the original database conflict.
            }

            var winner = await _db.ClientFiles
                .AsNoTracking()
                .FirstOrDefaultAsync(
                    f => f.TenantId == tenantId &&
                         f.ExternalAccountingDocumentId == externalAccountingDocumentId,
                    cancellationToken);

            if (winner != null)
                return winner;

            throw;
        }
        catch
        {
            _db.Entry(clientFile).State = EntityState.Detached;

            try
            {
                await _fileStorage.DeleteAsync(storageKey);
            }
            catch
            {
                // Preserve the original database exception.
            }

            throw;
        }
    }
    public async Task<List<FileResponse>> ListAsync(
        IQueryable<ClientFile> query,
        Guid tenantId)
    {
        var rows = await query
            .OrderByDescending(f => f.UploadedAt)
            .Select(f => new
            {
                f.Id,
                f.FileName,
                f.FileSize,
                f.UploadedAt,
                f.Title,
                f.ProjectId,
                ProjectName = f.Project != null
                    ? f.Project.Name
                    : null,
                f.UploadedByUserId
            })
            .ToListAsync();

        var userIds = rows
            .Select(r => r.UploadedByUserId)
            .Distinct()
            .ToArray();

        var users = userIds.Length == 0
            ? new Dictionary<Guid, string>()
            : await _db.Users
                .AsNoTracking()
                .Where(u =>
                    u.TenantId == tenantId &&
                    userIds.Contains(u.Id))
                .Select(u => new
                {
                    u.Id,
                    Name = u.FullName ?? u.Email
                })
                .ToDictionaryAsync(
                    u => u.Id,
                    u => u.Name);

        return rows
            .Select(r => new FileResponse(
                r.Id,
                r.FileName,
                r.FileSize,
                r.UploadedAt,
                r.Title,
                r.ProjectId,
                r.ProjectName,
                users.TryGetValue(
                    r.UploadedByUserId,
                    out var name)
                        ? name
                        : null))
            .ToList();
    }

    public async Task<Stream?> OpenReadAsync(
        ClientFile file,
        CancellationToken cancellationToken = default)
    {
        if (string.Equals(
                file.StorageProvider,
                S3StorageProvider,
                StringComparison.OrdinalIgnoreCase))
        {
            if (string.IsNullOrWhiteSpace(file.StorageKey))
                return null;

            return await _fileStorage.OpenReadAsync(
                file.StorageKey,
                cancellationToken);
        }

        // Existing/local ClientFile behavior.
        if (string.IsNullOrWhiteSpace(file.FilePath) ||
            !File.Exists(file.FilePath))
        {
            return null;
        }

        return File.OpenRead(file.FilePath);
    }

    public async Task DeleteAsync(ClientFile file)
    {
        if (string.Equals(
                file.StorageProvider,
                S3StorageProvider,
                StringComparison.OrdinalIgnoreCase))
        {
            if (!string.IsNullOrWhiteSpace(file.StorageKey))
                await _fileStorage.DeleteAsync(file.StorageKey);
        }
        else
        {
            // Existing/local ClientFile behavior.
            if (!string.IsNullOrWhiteSpace(file.FilePath) &&
                File.Exists(file.FilePath))
            {
                File.Delete(file.FilePath);
            }
        }

        _db.ClientFiles.Remove(file);
        await _db.SaveChangesAsync();
    }

    public string GetContentType(string fileName) =>
        Path.GetExtension(fileName).ToLowerInvariant() switch
        {
            ".pdf" => "application/pdf",
            ".doc" => "application/msword",
            ".docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".xls" => "application/vnd.ms-excel",
            ".xlsx" => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".txt" => "text/plain",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            _ => "application/octet-stream"
        };
}